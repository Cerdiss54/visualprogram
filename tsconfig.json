{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",         
    "moduleResolution": "Node16",
    "lib": ["ES2020"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",            
    "rootDir": ".",                 
    "types": ["vitest/globals"],   
    "isolatedModules": true,       
    "noEmit": true                 
  },
  "include": [
    "src/**/*.ts",               
    "tests/**/*.ts"                  
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}